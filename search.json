---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": "{{ site.baseurl }}{{ post.url }}",
    "date": "{{ post.date | date: '%d %b %Y' }}",
    "category": {{ post.categories | first | default: "" | jsonify }},
    "tags": {{ post.tags | join: ", " | default: "" | jsonify }},
    "author": {% assign a = site.data.authors[post.author] %}{{ a.name | default: post.author | default: "" | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | truncatewords: 80 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
